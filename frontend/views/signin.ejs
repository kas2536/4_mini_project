<%- include('partials/header') %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h3 class="fw-bold mb-3">Sign In</h3>
        <% if (error) { %>
          <div class="alert alert-danger py-2"><%= error %></div>
        <% } %>
        <form action="/signin" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-semibold">User ID</label>
            <input type="text" name="user_id" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Password</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary w-100 fw-bold">Sign In</button>
        </form>
        <p class="mt-3 text-center small">Need an account? <a href="/signup">Sign Up</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>