<%- include('partials/header') %>

<div class="row g-4">
  <!-- Left Column: Creation Form (Only visible if signed in) -->
  <div class="col-lg-4">
    <% if (currentUser) { %>
      <div class="card shadow-sm border-0 sticky-lg-top" style="top: 1.5rem;">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-pencil-square text-primary"></i> Create Blog Post
          </h5>
          <form action="/posts" method="POST">
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Title</label>
              <input type="text" name="title" class="form-control" placeholder="Blog Title" required>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Category</label>
              <select name="category" class="form-select" required>
                <option value="Tech">Tech</option>
                <option value="Lifestyle">Lifestyle</option>
                <option value="Education">Education</option>
                <option value="General">General</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">Content</label>
              <textarea name="content" class="form-control" rows="4" placeholder="Write your content..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold">Publish Post</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="card shadow-sm border-0 bg-white p-4 text-center">
        <i class="bi bi-person-lock fs-1 text-secondary mb-2"></i>
        <h5 class="fw-bold">Sign in to Publish</h5>
        <p class="text-muted small">You must be signed in to create, edit, or delete blog posts.</p>
        <a href="/signin" class="btn btn-primary btn-sm fw-bold">Sign In Now</a>
      </div>
    <% } %>
  </div>

  <!-- Right Column: Blog Feed -->
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <h4 class="fw-bold m-0">Recent Posts</h4>
      
      <!-- Category Filter -->
      <form action="/" method="GET" class="d-flex align-items-center gap-2">
        <label class="form-label m-0 small fw-semibold text-secondary">Filter:</label>
        <select name="category" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
          <option value="All" <%= selectedCategory === 'All' ? 'selected' : '' %>>All Categories</option>
          <option value="Tech" <%= selectedCategory === 'Tech' ? 'selected' : '' %>>Tech</option>
          <option value="Lifestyle" <%= selectedCategory === 'Lifestyle' ? 'selected' : '' %>>Lifestyle</option>
          <option value="Education" <%= selectedCategory === 'Education' ? 'selected' : '' %>>Education</option>
          <option value="General" <%= selectedCategory === 'General' ? 'selected' : '' %>>General</option>
        </select>
      </form>
    </div>

    <% if (posts.length === 0) { %>
      <div class="alert alert-info border-0 shadow-sm text-center py-4">No posts found.</div>
    <% } else { %>
      <div class="d-flex flex-column gap-3">
        <% posts.forEach(post => { %>
          <div class="card shadow-sm border-0 blog-card">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-primary-subtle text-primary fw-semibold px-2.5 py-1">
                  <%= post.category %>
                </span>
                <small class="text-muted">
                  <i class="bi bi-clock me-1"></i><%= new Date(post.date_created).toLocaleString() %>
                </small>
              </div>
              <h5 class="card-title fw-bold text-dark mb-1"><%= post.title %></h5>
              <p class="text-muted small mb-3">By <span class="fw-medium text-dark"><%= post.creator_name %> (@<%= post.creator_user_id %>)</span></p>
              <p class="card-text text-secondary mb-4"><%= post.body %></p>
              
              <!-- Check if logged-in user matches the post author -->
              <% if (currentUser && currentUser.user_id === post.creator_user_id) { %>
                <div class="d-flex gap-2 justify-content-end border-top pt-3">
                  <a href="/posts/<%= post.blog_id %>/edit" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                    <i class="bi bi-pencil"></i> Edit
                  </a>
                  <form action="/posts/<%= post.blog_id %>?_method=DELETE" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" onclick="return confirm('Delete this post?')">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </form>
                </div>
              <% } %>

            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>